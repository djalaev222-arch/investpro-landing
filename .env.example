# Telegram Bot Gateway
# 1. Создайте бота через @BotFather, скопируйте токен
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. Узнайте chat_id своего канала/группы через @userinfobot или @getidsbot
#    Для личного чата с ботом — ваш личный chat_id
#    Для канала — например: -1001234567890
TELEGRAM_CHAT_ID=123456789
